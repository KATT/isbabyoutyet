{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".vercel/output/**"],
      "env": [
        "BETTER_AUTH_SECRET",
        "VITE_CONVEX_URL",
        "VITE_CONVEX_SITE_URL",
        "VITE_SITE_URL",
        "VITE_HAS_DEMO_LOGIN",
        "VERCEL",
        "VERCEL_ENV"
      ],
      "passThroughEnv": ["VERCEL", "VERCEL_ENV", "VERCEL_URL", "VERCEL_GIT_COMMIT_REF", "VERCEL_BRANCH_URL", "VERCEL_PROJECT_PRODUCTION_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {},
    "lint": {
    },
    "lint-fix": {
    },
    "format": {
    }
  }
}

