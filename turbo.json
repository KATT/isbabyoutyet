{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"],
      "env": [
        "BETTER_AUTH_SECRET",
        "VITE_CONVEX_URL",
        "VITE_CONVEX_SITE_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
    },
    "lint-fix": {
    },
    "format": {
    }
  }
}

