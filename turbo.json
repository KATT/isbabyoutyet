{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".vercel/output/**"],
      "env": [
        "BETTER_AUTH_SECRET",
        "VITE_CONVEX_URL",
        "VITE_CONVEX_SITE_URL",
        "VITE_SITE_URL",
        "VITE_HAS_DEMO_LOGIN",
        "VERCEL",
        "VERCEL_ENV"
      ],
      "passThroughEnv": ["VERCEL", "VERCEL_ENV", "VERCEL_URL", "VERCEL_GIT_COMMIT_REF", "VERCEL_BRANCH_URL", "VERCEL_PROJECT_PRODUCTION_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {},
    "lint": {
    },
    "lint-fix": {
    },
    "format": {
    },
    "//#test:coverage": {
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/oxlint-plugins/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/coverage/**",
        "!$TURBO_ROOT$/**/paraglide/**",
        "!$TURBO_ROOT$/**/_generated/**",
        "!$TURBO_ROOT$/**/routeTree.gen.ts",
        "!$TURBO_ROOT$/**/project.inlang/cache/**",
        "!$TURBO_ROOT$/**/*.md",
        "!$TURBO_ROOT$/.github/**",
        "!$TURBO_ROOT$/.agents/**",
        "!$TURBO_ROOT$/.cursor/**"
      ],
      "env": ["CI"]
    },
    "//#knip": {
      "cache": false
    }
  }
}
