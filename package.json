{
  "name": "isbabyoutyet",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev-convex": "cd packages/convex && pnpm dev",
    "reset-dev": "pnpm --filter @workspace/convex reset-dev",
    "lint": "turbo lint",
    "lint-fix": "turbo lint-fix",
    "typecheck": "turbo typecheck",
    "typecheck:scripts": "tsc --noEmit -p scripts",
    "format": "turbo format",
    "pretest": "pnpm --filter web i18n:compile",
    "test": "vitest run",
    "pretest:coverage:web": "pnpm --filter web i18n:compile",
    "test:coverage:convex": "tsx scripts/runVitestCoverageBlob.ts convex",
    "test:coverage:query-prefetch": "tsx scripts/runVitestCoverageBlob.ts query-prefetch",
    "test:coverage:convex-prefetch": "tsx scripts/runVitestCoverageBlob.ts convex-prefetch",
    "test:coverage:web": "tsx scripts/runVitestCoverageBlob.ts web",
    "test:coverage:oxlint-plugins": "tsx scripts/runVitestCoverageBlob.ts oxlint-plugins",
    "test:coverage:merge": "vitest run --merge-reports=.vitest-blobs --coverage",
    "test:coverage": "turbo run test:coverage:merge",
    "coverage:compare": "tsx scripts/compareCoverage.ts .coverage-baseline/coverage-summary.json coverage/coverage-summary.json",
    "preknip": "pnpm --filter web i18n:compile",
    "knip": "knip --production",
    "checks": "pnpm typecheck:scripts && pnpm format && pnpm lint-fix && pnpm typecheck && pnpm test:coverage && pnpm knip"
  },
  "devDependencies": {
    "@rrazvan.dev/oxlint-plugin-i18n-literal": "^1.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^4.1.11",
    "knip": "^6.32.2",
    "npm-run-all": "^4.1.5",
    "oxlint": "catalog:",
    "tsx": "^4.23.12",
    "turbo": "^2.10.11",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@10.26.1+sha512.664074abc367d2c9324fdc18037097ce0a8f126034160f709928e9e9f95d98714347044e5c3164d65bd5da6c59c6be362b107546292a8eecb7999196e5ce58fa"
}
