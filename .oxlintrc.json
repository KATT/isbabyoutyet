{
  "$schema": "./packages/convex/node_modules/oxlint/configuration_schema.json",
  // Closely matches `oxlint --init`, plus the stricter `suspicious` category.
  // Pedantic/style/restriction stay off — too noisy for a blanket enable.
  "plugins": ["typescript", "unicorn", "oxc", "vitest", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "builtin": true
  },
  // Generated code is not ours to lint
  "ignorePatterns": ["**/_generated/**", "**/routeTree.gen.ts", "oxlint-plugins/**"],
  "jsPlugins": [
    {
      "name": "i18n-literal",
      "specifier": "@rrazvan.dev/oxlint-plugin-i18n-literal"
    },
    {
      "name": "no-optional",
      "specifier": "./oxlint-plugins/no-optional.mjs"
    },
    {
      "name": "no-mock",
      "specifier": "./oxlint-plugins/no-mock.mjs"
    },
    {
      "name": "no-convex-stubs",
      "specifier": "./oxlint-plugins/no-convex-stubs.mjs"
    },
    {
      "name": "query-prefetch",
      "specifier": "./oxlint-plugins/query-prefetch.mjs"
    },
    {
      "name": "no-overzealous-destructuring",
      "specifier": "./oxlint-plugins/no-overzealous-destructuring.mjs"
    },
    {
      "name": "inline-jsx-callback",
      "specifier": "./oxlint-plugins/inline-jsx-callback.mjs"
    },
    {
      "name": "no-use-effect",
      "specifier": "./oxlint-plugins/no-use-effect.mjs"
    },
    {
      "name": "no-use-state",
      "specifier": "./oxlint-plugins/no-use-state.mjs"
    },
    {
      "name": "no-banned-react-reexport",
      "specifier": "./oxlint-plugins/no-banned-react-reexport.mjs"
    },
    {
      "name": "react-compiler",
      "specifier": "./oxlint-plugins/react-compiler.mjs"
    },
    {
      "name": "infer-callback-params",
      "specifier": "./oxlint-plugins/infer-callback-params.mjs"
    },
    {
      "name": "no-rhf-watch",
      "specifier": "./oxlint-plugins/no-rhf-watch.mjs"
    },
    {
      "name": "anti-slop",
      "specifier": "./oxlint-plugins/compiled/anti-slop.js"
    }
  ],
  "settings": {
    "i18n-literal": {
      "presets": ["react"],
      "translationFunctionNames": ["translate"],
      "ignoredAttributes": ["to", "params", "search"],
      "ignoredComponents": ["TanStackDevtools"],
      "ignorePatterns": ["^LoadingMore$", "^TanStack (Router|Query)$", "^/[A-Za-z0-9_$/.-]+$"]
    }
  },
  "rules": {
    // Project-specific (keep):
    "vitest/no-hooks": "error",
    // Ban module mocking everywhere — tests *and* shared test helpers, so a
    // helper cannot reintroduce it behind a seam.
    "no-mock/no-mock": "error",
    "eslint/max-params": ["error", 2],
    // Type assertions can hide mismatches. Narrow values or use `satisfies` instead.
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    // Anti-Slop zero-cost rules (no current violations):
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-runtime-typeof": ["error", { "allowInTypeGuards": true }],
    // Convex system fields use leading underscores (`_id`, `_creationTime`).
    "eslint/no-underscore-dangle": ["error", { "allow": ["_id", "_creationTime", "_exhaustive"] }],
    "react-compiler/no-manual-memoization": "error",
    "query-prefetch/no-convex-query-hooks": "error",
    "no-use-effect/no-use-effect": "error",
    "no-use-state/no-use-state": "error",
    // Always on — including apps/web/src/lib — so banned hooks cannot be
    // laundered through a local re-export barrel.
    "no-banned-react-reexport/no-banned-react-reexport": "error"
  },
  "overrides": [
    {
      // Tests sometimes need assertions to build deliberately incomplete or invalid values.
      "files": [
        "**/*.test.{js,jsx,ts,tsx}",
        "**/*.spec.{js,jsx,ts,tsx}",
        "**/test-*.{js,jsx,ts,tsx}",
        "**/test.*.{js,jsx,ts,tsx}",
        "**/test/**/*.{js,jsx,ts,tsx}",
        "**/tests/**/*.{js,jsx,ts,tsx}",
        "**/__tests__/**/*.{js,jsx,ts,tsx}"
      ],
      "rules": {
        "anti-slop/no-chained-type-assertions": "off",
        "anti-slop/no-widen-then-assert": "off",
        "anti-slop/no-known-value-widening": "off",
        "anti-slop/require-safety-comment-for-type-assertion": "off",
        "typescript/consistent-type-assertions": "off"
      }
    },
    {
      "files": ["apps/web/src/**/*.{ts,tsx}"],
      "rules": {
        "infer-callback-params/infer-callback-params": "error",
        "i18n-literal/no-literal-string": "error",
        "i18n-literal/no-literal-jsx-attribute": "error",
        "i18n-literal/no-literal-template": "error",
        "inline-jsx-callback/inline-jsx-callback": "error",
        "no-optional/no-optional": "error",
        "no-overzealous-destructuring/no-overzealous-destructuring": "error",
        "no-rhf-watch/no-rhf-watch": "error",
        "query-prefetch/require-preloaded-query-options": "error",
        "query-prefetch/use-loader-preloads": "error",
        // Automatic JSX runtime — no React import required.
        "react/react-in-jsx-scope": "off"
      }
    },
    {
      "files": [
        "apps/web/src/routes/demo/**/*.{ts,tsx}",
        "apps/web/src/**/*.test.{ts,tsx}",
        "apps/web/src/components/dev-bar.tsx",
        "apps/web/src/components/demo-account-picker.tsx",
        "apps/web/src/lib/robots.ts",
        "apps/web/src/routes/robots[.]txt.ts",
        "apps/web/src/routes/sitemap[.]xml.ts"
      ],
      "rules": {
        "i18n-literal/no-literal-string": "off",
        "i18n-literal/no-literal-jsx-attribute": "off",
        "i18n-literal/no-literal-template": "off",
        "query-prefetch/require-preloaded-query-options": "off",
        "query-prefetch/use-loader-preloads": "off"
      }
    },
    {
      // Steer web tests toward convex-test harness instead of stub clients /
      // fake preloaded handles.
      "files": ["apps/web/src/**/*.test.{ts,tsx}"],
      "rules": {
        "no-convex-stubs/no-invalid-convex-client": "error",
        "no-convex-stubs/no-test-preloaded-query": "error"
      }
    },
    {
      // Unused `await using _foo = …` bindings follow the project unused-var
      // convention and trip no-underscore-dangle outside function params.
      "files": ["**/*.{test,spec}.{ts,tsx}"],
      "rules": {
        "eslint/no-underscore-dangle": "off",
        "vitest/require-mock-type-parameters": "off",
        "vitest/no-conditional-expect": "off",
        "react/immutability": "off",
        "react/set-state-in-effect": "off",
        "react/exhaustive-effect-dependencies": "off",
        "react-hooks/exhaustive-deps": "off",
        "unicorn/consistent-function-scoping": "off",
        "unicorn/prefer-add-event-listener": "off"
      }
    },
    {
      // Peer-type bridge for better-auth vs @convex-dev/better-auth AuthClient.
      "files": ["apps/web/src/lib/auth-client-bridge.ts"],
      "rules": {
        "typescript/consistent-type-assertions": "off",
        "anti-slop/no-chained-type-assertions": "off",
        "anti-slop/require-safety-comment-for-type-assertion": "off",
        "anti-slop/no-widen-then-assert": "off"
      }
    },
    {
      // Service worker: plain JS JSON boundary (no TS type predicates).
      "files": ["apps/web/public/sw.js"],
      "rules": {
        "anti-slop/no-runtime-typeof": "off"
      }
    },
    {
      // Boundary module: accepts unparsed external values (unknown / Record).
      "files": ["packages/runtime/src/guards.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unknown-returns": "off",
        "anti-slop/no-unsafe-dictionary-type": "off"
      }
    },
    {
      // Vendored shadcn/ui registry components — not first-party code.
      "files": ["packages/ui/src/**"],
      "rules": {
        "typescript/consistent-type-assertions": "off",
        "anti-slop/no-chained-type-assertions": "off",
        "anti-slop/no-conditional-empty-object-spread": "off",
        "anti-slop/no-known-value-widening": "off",
        "anti-slop/no-module-mocking": "off",
        "anti-slop/no-object-parameters": "off",
        "anti-slop/no-reflect-apply": "off",
        "anti-slop/no-reflect-get": "off",
        "anti-slop/no-runtime-typeof": "off",
        "anti-slop/no-shape-in-symbol-names": "off",
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unknown-returns": "off",
        "anti-slop/no-unknown-type-aliases": "off",
        "anti-slop/no-unsafe-dictionary-type": "off",
        "anti-slop/no-widen-then-assert": "off",
        "anti-slop/require-safety-comment-for-type-assertion": "off",
        "eslint/max-params": "off",
        "eslint/no-shadow": "off",
        "eslint/no-underscore-dangle": "off",
        "no-use-effect/no-use-effect": "off",
        "no-use-state/no-use-state": "off",
        "react-compiler/no-manual-memoization": "off",
        "react/react-in-jsx-scope": "off",
        "react/no-unstable-nested-components": "off",
        "react/set-state-in-effect": "off",
        "react/exhaustive-effect-dependencies": "off",
        "react/immutability": "off",
        "react-hooks/exhaustive-deps": "off"
      }
    },
    {
      // Audited React-hook seams under lib (not the whole lib directory).
      // Timers/observers/stores may use effects, local state, and latest-callback
      // refs written during render. Feature components stay banned.
      "files": [
        "apps/web/src/lib/use-*.{ts,tsx}",
        "apps/web/src/lib/overlay-nav.ts",
        "apps/web/src/lib/convexAuthHandoff.ts"
      ],
      "rules": {
        "no-use-effect/no-use-effect": "off",
        "no-use-state/no-use-state": "off",
        "react/set-state-in-effect": "off",
        "react/refs": "off",
        "react/immutability": "off"
      }
    },
    {
      // query-prefetch overloads use an optional third `remixInput` param (KATT gist API).
      "files": ["packages/query-prefetch/src/**"],
      "rules": {
        "eslint/max-params": "off"
      }
    },
    {
      // Render-time useState adjustment is required here: react/refs forbids
      // reading refs during render, and useSyncExternalStore needs a stable
      // subscribe identity when watch deps are deeply equal.
      "files": ["packages/convex-prefetch/src/useLiveConvexInfinitePages.ts"],
      "rules": {
        "no-use-state/no-use-state": "off"
      }
    }
  ]
}
