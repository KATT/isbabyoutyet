{
  "$schema": "./packages/convex/node_modules/oxlint/configuration_schema.json",
  // Closely matches `oxlint --init`, plus the stricter `suspicious` category.
  // Pedantic/style/restriction stay off — too noisy for a blanket enable.
  "plugins": ["typescript", "unicorn", "oxc", "vitest", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "builtin": true
  },
  // Generated code is not ours to lint
  "ignorePatterns": ["**/_generated/**", "**/routeTree.gen.ts", "oxlint-plugins/**"],
  "jsPlugins": [
    {
      "name": "i18n-literal",
      "specifier": "@rrazvan.dev/oxlint-plugin-i18n-literal"
    },
    {
      "name": "no-optional",
      "specifier": "./oxlint-plugins/no-optional.mjs"
    },
    {
      "name": "query-prefetch",
      "specifier": "./oxlint-plugins/query-prefetch.mjs"
    },
    {
      "name": "no-overzealous-destructuring",
      "specifier": "./oxlint-plugins/no-overzealous-destructuring.mjs"
    },
    {
      "name": "inline-jsx-callback",
      "specifier": "./oxlint-plugins/inline-jsx-callback.mjs"
    },
    {
      "name": "react-compiler",
      "specifier": "./oxlint-plugins/react-compiler.mjs"
    },
    {
      "name": "infer-callback-params",
      "specifier": "./oxlint-plugins/infer-callback-params.mjs"
    }
  ],
  "settings": {
    "i18n-literal": {
      "presets": ["react"],
      "translationFunctionNames": ["translate"],
      "ignoredAttributes": ["to", "params", "search"],
      "ignoredComponents": ["TanStackDevtools"],
      "ignorePatterns": ["^LoadingMore$", "^TanStack (Router|Query)$", "^/[A-Za-z0-9_$/.-]+$"]
    }
  },
  "rules": {
    // Project-specific (keep):
    "vitest/no-hooks": "error",
    // Prefer an options object over long positional argument lists.
    "eslint/max-params": ["error", 2],
    // Type assertions can hide mismatches. Narrow values or use `satisfies` instead.
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    // Convex system fields use leading underscores (`_id`, `_creationTime`).
    "eslint/no-underscore-dangle": ["error", { "allow": ["_id", "_creationTime", "_exhaustive"] }],
    "react-compiler/no-manual-memoization": "error",
    "query-prefetch/no-convex-query-hooks": "error"
  },
  "overrides": [
    {
      // Tests sometimes need assertions to build deliberately incomplete or invalid values.
      "files": [
        "**/*.test.{js,jsx,ts,tsx}",
        "**/*.spec.{js,jsx,ts,tsx}",
        "**/test-*.{js,jsx,ts,tsx}",
        "**/test.*.{js,jsx,ts,tsx}",
        "**/test/**/*.{js,jsx,ts,tsx}",
        "**/tests/**/*.{js,jsx,ts,tsx}",
        "**/__tests__/**/*.{js,jsx,ts,tsx}"
      ],
      "rules": {
        "typescript/consistent-type-assertions": "off"
      }
    },
    {
      "files": ["apps/web/src/**/*.{ts,tsx}"],
      "rules": {
        "infer-callback-params/infer-callback-params": "error",
        "i18n-literal/no-literal-string": "error",
        "i18n-literal/no-literal-jsx-attribute": "error",
        "i18n-literal/no-literal-template": "error",
        "inline-jsx-callback/inline-jsx-callback": "error",
        "no-optional/no-optional": "error",
        "no-overzealous-destructuring/no-overzealous-destructuring": "error",
        "query-prefetch/require-preloaded-query-options": "error",
        "query-prefetch/use-loader-preloads": "error",
        // Automatic JSX runtime — no React import required.
        "react/react-in-jsx-scope": "off"
      }
    },
    {
      "files": [
        "apps/web/src/routes/demo/**/*.{ts,tsx}",
        "apps/web/src/**/*.test.{ts,tsx}",
        "apps/web/src/components/dev-bar.tsx",
        "apps/web/src/components/demo-account-picker.tsx",
        "apps/web/src/lib/robots.ts",
        "apps/web/src/routes/robots[.]txt.ts",
        "apps/web/src/routes/sitemap[.]xml.ts"
      ],
      "rules": {
        "i18n-literal/no-literal-string": "off",
        "i18n-literal/no-literal-jsx-attribute": "off",
        "i18n-literal/no-literal-template": "off",
        "query-prefetch/require-preloaded-query-options": "off",
        "query-prefetch/use-loader-preloads": "off"
      }
    },
    {
      // Unused `await using _foo = …` bindings follow the project unused-var
      // convention and trip no-underscore-dangle outside function params.
      "files": ["**/*.{test,spec}.{ts,tsx}"],
      "rules": {
        "eslint/no-underscore-dangle": "off",
        "vitest/require-mock-type-parameters": "off",
        "vitest/no-conditional-expect": "off",
        "react/immutability": "off",
        "react/set-state-in-effect": "off",
        "react/exhaustive-effect-dependencies": "off",
        "react-hooks/exhaustive-deps": "off",
        "unicorn/consistent-function-scoping": "off",
        "unicorn/prefer-add-event-listener": "off"
      }
    },
    {
      // Vendored shadcn/ui registry components — not first-party code.
      "files": ["packages/ui/src/**"],
      "rules": {
        "eslint/max-params": "off",
        "eslint/no-shadow": "off",
        "eslint/no-underscore-dangle": "off",
        "react-compiler/no-manual-memoization": "off",
        "react/react-in-jsx-scope": "off",
        "react/no-unstable-nested-components": "off",
        "react/set-state-in-effect": "off",
        "react/exhaustive-effect-dependencies": "off",
        "react/immutability": "off",
        "react-hooks/exhaustive-deps": "off"
      }
    },
    {
      // query-prefetch overloads use an optional third `remixInput` param (KATT gist API).
      "files": ["packages/query-prefetch/src/**"],
      "rules": {
        "eslint/max-params": "off"
      }
    }
  ]
}
