{
  "name": "@workspace/convex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./convex/*": "./convex/*.ts",
    "./convex/_generated/*": "./convex/_generated/*.js",
    "./src/*": "./src/*.ts"
  },
  "scripts": {
    "predev": "node scripts/setup-dev-env.mjs",
    "dev": "CONVEX_AGENT_MODE=anonymous convex dev",
    "setup-dev": "node scripts/setup-dev-env.mjs",
    "test": "vitest run",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix",
    "format": "oxfmt && oxlint --fix",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit -p convex"
  },
  "dependencies": {
    "@convex-dev/better-auth": "catalog:",
    "@convex-dev/migrations": "^0.3.6",
    "better-auth": "catalog:",
    "convex": "catalog:",
    "convex-helpers": "^0.1.122",
    "convex-table-history": "^0.1.2",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.20.1",
    "@types/web-push": "^3.6.4",
    "convex-test": "^0.0.55",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "zod": "catalog:"
  }
}
