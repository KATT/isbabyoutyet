{
  "name": "@workspace/convex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./convex/*": "./convex/*.ts",
    "./convex/_generated/api": "./convex/_generated/api.js",
    "./convex/_generated/api.js": "./convex/_generated/api.js",
    "./convex/_generated/*": "./convex/_generated/*.js",
    "./confect/*": "./confect/*.ts",
    "./confect/_generated/refs": "./confect/_generated/refs.ts",
    "./confect/_generated/*": "./confect/_generated/*.ts",
    "./src/*": "./src/*.ts",
    "./tests/*": "./tests/*.ts"
  },
  "scripts": {
    "predev:kill": "lsof -ti:3210 | xargs kill -9 2>/dev/null || true",
    "predev:setup-if-needed": "[ -f .env.local ] || pnpm setup-dev",
    "predev": "run-s predev:*",
    "dev": "run-p --print-label confect:dev dev:convex",
    "dev-set-env:BETTER_AUTH_SECRET": "convex env set BETTER_AUTH_SECRET localhost",
    "dev-set-env:SITE_URL": "convex env set SITE_URL http://localhost:3000",
    "dev-set-env:vapid": "web-push generate-vapid-keys --json | jq -r '\"npx convex env set VAPID_PUBLIC_KEY \" + .publicKey + \"\\nnpx convex env set VAPID_PRIVATE_KEY \" + .privateKey' | sh",
    "setup-dev": "FORCE_COLOR=1 run-p setup-dev:* --print-label && pnpm seed && echo '✅ Setup complete, you can now run `pnpm dev`'",
    "setup-dev:set-env": "wait-on tcp:3210 && echo 'Convex is ready, setting environment variables...' && sleep 1 && run-s dev-set-env:*",
    "setup-dev:dev": "CONVEX_AGENT_MODE=anonymous convex dev --until-success",
    "seed": "convex run seed:seedDemoData",
    "test": "vitest run",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix",
    "format": "oxfmt && oxlint --fix",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit -p convex && tsc --noEmit -p confect",
    "confect:codegen": "confect codegen",
    "confect:dev": "confect dev",
    "dev:convex": "CONVEX_AGENT_MODE=anonymous convex dev"
  },
  "dependencies": {
    "@confect/cli": "catalog:",
    "@confect/core": "catalog:",
    "@confect/server": "catalog:",
    "@convex-dev/better-auth": "catalog:",
    "@convex-dev/migrations": "^0.3.6",
    "better-auth": "catalog:",
    "convex": "catalog:",
    "convex-helpers": "^0.1.122",
    "convex-table-history": "^0.1.2",
    "effect": "catalog:",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@confect/test": "catalog:",
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.20.1",
    "@types/web-push": "^3.6.4",
    "convex-test": "^0.0.55",
    "npm-run-all": "^4.1.5",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0",
    "zod": "catalog:"
  }
}
