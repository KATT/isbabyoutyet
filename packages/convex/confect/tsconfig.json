{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "lib": ["ES2021", "DOM", "ESNext.Disposable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["./**/*", "../src/**/*"],
  "exclude": ["./_generated"]
}
