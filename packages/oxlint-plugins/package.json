{
  "name": "@workspace/oxlint-plugins",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./dist/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxfmt --check",
    "lint-fix": "oxfmt",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@oxlint/plugins": "catalog:"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  }
}
