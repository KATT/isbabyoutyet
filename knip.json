{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/_generated/**",
    "**/routeTree.gen.ts",
    "coverage/**",
    "**/paraglide/**",
    "oxlint-plugins/**"
  ],
  "workspaces": {
    ".": {
      "entry": ["scripts/compareCoverage.ts!"]
    },
    "apps/web": {
      "tanstack-router": {
        "entry": ["src/routes/**/*.{ts,tsx}!", "src/router.tsx!"]
      },
      "entry": [
        "public/sw.js!",
        "src/server.ts!",
        "vite.config.ts!",
        "scripts/deploy-convex.ts!",
        "scripts/build-web.mjs!"
      ]
    },
    "packages/convex": {
      "entry": ["scripts/seedHomepageDemo.ts!", "scripts/seedHomepagePhotosDeferred.ts!"]
    },
    "packages/query-prefetch": {},
    "packages/convex-prefetch": {},
    "packages/ui": {}
  }
}
