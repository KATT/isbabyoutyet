{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["**/_generated/**", "**/routeTree.gen.ts", "coverage/**"],
  "workspaces": {
    ".": {},
    "apps/web": {
      "tanstack-router": {
        "entry": ["src/routes/**/*.{ts,tsx}!", "src/router.tsx!"]
      },
      "entry": [
        "public/sw.js!",
        "vite.config.ts!",
        "scripts/deploy-convex.ts!",
        "scripts/build-web.mjs!"
      ]
    },
    "packages/convex": {},
    "packages/ui": {
      // All workspaces are private, so the package `exports` field is not a
      // public API: exports of entry files that no workspace imports are
      // dead code, including vendored shadcn components.
      "includeEntryExports": true,
      // ...but exports also used within their own file (e.g. cva variants
      // like `buttonVariants`) stay untouched.
      "ignoreExportsUsedInFile": true
    }
  }
}
