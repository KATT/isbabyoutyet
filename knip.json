{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/_generated/**",
    "**/routeTree.gen.ts",
    "coverage/**",
    "**/paraglide/**",
    "packages/oxlint-plugins/dist/**"
  ],
  "tags": ["-@internal"],
  "workspaces": {
    ".": {
      "entry": ["scripts/compareCoverage.ts!"]
    },
    "apps/web": {
      "tanstack-router": {
        "entry": ["src/routes/**/*.{ts,tsx}!", "src/router.tsx!"]
      },
      "entry": [
        "public/sw.js!",
        "src/server.ts!",
        "src/test/setup.ts!",
        "src/test/convexTestHarness.ts!",
        "src/test/convexTestSeed.ts!",
        "src/test/renderWithConvexTest.tsx!",
        "src/test/renderMountedFileRoute.tsx!",
        "src/test/routeTestContext.ts!",
        "vite.config.ts!",
        "scripts/deploy-convex.ts!",
        "scripts/build-web.mjs!"
      ]
    },
    "packages/convex": {
      "entry": ["scripts/seedHomepageDemo.ts!", "scripts/seedHomepagePhotosDeferred.ts!"]
    },
    "packages/oxlint-plugins": {
      "entry": [
        "src/anti-slop.ts!",
        "src/infer-callback-params.ts!",
        "src/inline-jsx-callback.ts!",
        "src/no-banned-react-reexport.ts!",
        "src/no-convex-stubs.ts!",
        "src/no-mock.ts!",
        "src/no-optional.ts!",
        "src/no-overzealous-destructuring.ts!",
        "src/no-rhf-watch.ts!",
        "src/no-use-effect.ts!",
        "src/no-use-state.ts!",
        "src/query-prefetch.ts!",
        "src/react-compiler.ts!"
      ]
    },
    "packages/runtime": {},
    "packages/query-prefetch": {},
    "packages/convex-prefetch": {},
    "packages/ui": {}
  }
}
