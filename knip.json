{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/_generated/**",
    "**/routeTree.gen.ts",
    "coverage/**",
    "**/paraglide/**",
    "packages/oxlint-plugins/dist/**",
    "packages/scripts/dist/**"
  ],
  "tags": ["-@internal"],
  "workspaces": {
    "apps/web": {
      "tanstack-router": {
        "entry": ["src/routes/**/*.{ts,tsx}!", "src/router.tsx!"]
      },
      "entry": [
        "public/sw.js!",
        "src/server.ts!",
        "src/test/setup.ts!",
        "src/test/convexTestHarness.ts!",
        "src/test/convexTestSeed.ts!",
        "src/test/renderWithConvexTest.tsx!",
        "src/test/renderMountedFileRoute.tsx!",
        "src/test/routeTestContext.ts!",
        "vite.config.ts!",
        "scripts/deploy-convex.ts!",
        "scripts/build-web.mjs!"
      ]
    },
    "packages/convex": {
      "entry": ["scripts/seedHomepageDemo.ts!", "scripts/seedHomepagePhotosDeferred.ts!"]
    },
    "packages/oxlint-plugins": {
      "entry": [
        "workspace.ts!",
        "infer-callback-params.ts!",
        "inline-jsx-callback.ts!",
        "no-banned-react-reexport.ts!",
        "no-chained-type-assertions.ts!",
        "no-conditional-empty-object-spread.ts!",
        "no-convex-query-hooks.ts!",
        "no-invalid-convex-client.ts!",
        "no-known-value-widening.ts!",
        "no-manual-memoization.ts!",
        "no-mock.ts!",
        "no-module-mocking.ts!",
        "no-object-parameters.ts!",
        "no-optional.ts!",
        "no-overzealous-destructuring.ts!",
        "no-reflect-apply.ts!",
        "no-reflect-get.ts!",
        "no-rhf-watch.ts!",
        "no-runtime-typeof.ts!",
        "no-shape-in-symbol-names.ts!",
        "no-test-preloaded-query.ts!",
        "no-unknown-parameters.ts!",
        "no-unknown-returns.ts!",
        "no-unknown-type-aliases.ts!",
        "no-unsafe-dictionary-type.ts!",
        "no-use-effect.ts!",
        "no-use-state.ts!",
        "no-widen-then-assert.ts!",
        "query-prefetch-shared.ts!",
        "require-preloaded-query-options.ts!",
        "require-safety-comment-for-type-assertion.ts!",
        "use-loader-preloads.ts!"
      ]
    },
    "packages/scripts": {
      "entry": ["src/compareCoverage.ts!"]
    },
    "packages/runtime": {},
    "packages/query-prefetch": {},
    "packages/convex-prefetch": {},
    "packages/ui": {}
  }
}
