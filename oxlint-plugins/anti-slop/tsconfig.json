{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "compiled",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["index.ts", "rules/*.ts", "shared/*.ts"],
  "exclude": ["rules/*.test.ts"]
}
