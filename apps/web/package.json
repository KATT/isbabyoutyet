{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "run-s predev:*",
    "predev:kill": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true",
    "predev:setup-if-needed": "[ -f .env.local ] || pnpm setup-dev",
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix",
    "format": "oxfmt && oxlint --fix",
    "typecheck": "tsc --noEmit",
    "setup-dev": "cp .env.local.example .env.local",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@convex-dev/better-auth": "catalog:",
    "@convex-dev/react-query": "^0.1.0",
    "@hookform/resolvers": "^5.2.2",
